// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Employee {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  age         Int
  joiningDate DateTime @default(now())
  address     String
  mobile      String   @unique
}
