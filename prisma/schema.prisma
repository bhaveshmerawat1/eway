// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  employees Employee[]
}

model Employee {
  id         Int      @id @default(autoincrement())
  firstName  String
  lastName   String?
  age        Int?
  mobile     String?
  address    String?
  joinedAt   DateTime @default(now())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  size        String?
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cartItems   CartItem[]
  orderItems  OrderItem[]
}

model CartItem {
  id         String   @id @default(cuid())
  productId  String   // ✅ matches Product.id
  quantity   Int
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id])
}

model Order {
  id           String  @id @default(cuid())
  firstName    String
  lastName     String?
  email        String
  phone        String
  address      String
  city         String
  postalCode   String
  totalAmount  Float
  createdAt    DateTime    @default(now())
  orderItems   OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}


model SpecialOrder {
  id          String   @id @default(cuid())
  productName String
  quantity    Int
  createdAt   DateTime @default(now())
}
